+
+            // Most active entity
+            const transitionCounts = {};
+            transitions.forEach(t => {
+                transitionCounts[t.entity_id] = (transitionCounts[t.entity_id] || 0) + 1;
+            });
+            const mostActiveId = Object.entries(transitionCounts)
+                .sort((a, b) => b[1] - a[1])[0];
