+
+        function renderRelationshipGraph(entity) {
+            const graph = document.getElementById('relationshipGraph');
+            graph.innerHTML = '';
+
+            const relationships = Object.values(worldModel.relationships)
+                .filter(r => r.source_id === entity.id || r.target_id === entity.id);
+
+            if (relationships.length === 0) {
+                graph.innerHTML = '<div class="no-data-message">No relationships for this entity</div>';
+                return;
+            }
+
+            const centerNode = document.createElement('div');
+            centerNode.className = 'rel-node center';
+            centerNode.style.left = '50%';
+            centerNode.style.top = '50%';
+            centerNode.style.transform = 'translate(-50%, -50%)';
+            centerNode.innerHTML = `
+                <div class="rel-node-circle" style="background-color: ${ENTITY_COLORS[entity.type]};">
+                    ${ENTITY_ICONS[entity.type]}
+                </div>
+                <div class="rel-node-label">${escapeHtml(entity.name.substring(0, 20))}</div>
+            `;
+            graph.appendChild(centerNode);
+
+            // Calculate positions
+            const angleSlice = (Math.PI * 2) / relationships.length;
+            const radius = 150;
+
+            relationships.forEach((rel, idx) => {
+                const otherId = rel.source_id === entity.id ? rel.target_id : rel.source_id;
+                const otherEntity = worldModel.entities[otherId];
+
+                const angle = angleSlice * idx;
+                const x = 50 + Math.cos(angle) * radius / 300;
+                const y = 50 + Math.sin(angle) * radius / 300;
+
+                // Draw edge
+                const edge = document.createElement('div');
+                edge.className = 'rel-edge';
+                const centerX = 50;
+                const centerY = 50;
+                const edgeX = (x - centerX) * 300;
+                const edgeY = (y - centerY) * 300;
+                const edgeLength = Math.sqrt(edgeX * edgeX + edgeY * edgeY);
+                edge.style.width = edgeLength + 'px';
+                edge.style.left = (centerX + '%');
+                edge.style.top = (centerY + '%');
+                edge.style.transform = `rotate(${Math.atan2(edgeY, edgeX)}rad) translateY(-1px)`;
+                edge.style.borderColor = ENTITY_COLORS[otherEntity.type];
+                graph.appendChild(edge);
+
+                // Draw node
+                const node = document.createElement('div');
+                node.className = 'rel-node';
+                node.style.left = (x + '%');
+                node.style.top = (y + '%');
+                node.style.transform = 'translate(-50%, -50%)';
+                node.innerHTML = `
+                    <div class="rel-node-circle" style="background-color: ${ENTITY_COLORS[otherEntity.type]};">
+                        ${ENTITY_ICONS[otherEntity.type]}
+                    </div>
+                    <div class="rel-node-label">${escapeHtml(otherEntity.name.substring(0, 20))}</div>
+                `;
+                node.addEventListener('click', () => renderRelationshipGraph(otherEntity));
+                graph.appendChild(node);
+
+                // Draw relationship label
+                const labelX = centerX + (edgeX / 2);
+                const labelY = centerY + (edgeY / 2);
+                const label = document.createElement('div');
+                label.className = 'rel-edge-label';
+                label.style.left = (labelX + '%');
+                label.style.top = (labelY + '%');
+                label.textContent = rel.type;
+                graph.appendChild(label);
+            });
+        }
+
+        function renderInsights() {
+            const entities = Object.values(worldModel.entities);
+            const relationships = Object.values(worldModel.relationships);
+            const transitions = Object.values(worldModel.transitions);
+
+            // Most active entities
+            const transitionCounts = {};
+            transitions.forEach(t => {
+                transitionCounts[t.entity_id] = (transitionCounts[t.entity_id] || 0) + 1;
+            });
+
+            const mostActive = Object.entries(transitionCounts)
+                .sort((a, b) => b[1] - a[1])
+                .slice(0, 10);
+
+            // Recently changed
+            const recentlyChanged = entities
+                .filter(e => e.last_seen)
+                .sort((a, b) => b.last_seen - a.last_seen)
+                .slice(0, 10);
+
+            // Contradiction hotspots
+            const contradictions = transitions.filter(t =>
+                t.transition_type && t.transition_type.includes('contradiction')
+            );
+            const contradictionEntities = {};
+            contradictions.forEach(c => {
+                const entity = worldModel.entities[c.entity_id];
+                contradictionEntities[c.entity_id] = entity;
+            });
+
+            // Orphan entities (no relationships)
+            const relatedEntities = new Set();
+            relationships.forEach(r => {
+                relatedEntities.add(r.source_id);
+                relatedEntities.add(r.target_id);
+            });
+            const orphans = entities.filter(e => !relatedEntities.has(e.id)).slice(0, 10);
+
+            // Belief evolution
+            const beliefs = entities.filter(e => e.type === 'belief');
+            const beliefTransitions = transitions.filter(t => {
+                const entity = worldModel.entities[t.entity_id];
+                return entity && entity.type === 'belief';
+            });
+
+            const grid = document.getElementById('insightsGrid');
+            grid.innerHTML = `
+                <div class="insight-card">
+                    <div class="insight-title">Most Active Entities</div>
+                    ${mostActive.map(([id, count]) => {
+                        const entity = worldModel.entities[id];
+                        return `
+                            <div class="insight-item">
+                                <div class="insight-item-title">${escapeHtml(entity.name.substring(0, 40))}</div>
+                                <div class="insight-item-value">${count} transitions</div>
+                            </div>
+                        `;
+                    }).join('')}
+                </div>
+
+                <div class="insight-card">
+                    <div class="insight-title">Recently Changed Entities</div>
+                    ${recentlyChanged.map(entity => {
+                        const date = new Date(entity.last_seen * 1000).toLocaleDateString();
+                        return `
+                            <div class="insight-item">
+                                <div class="insight-item-title">${escapeHtml(entity.name.substring(0, 40))}</div>
+                                <div class="insight-item-value">${date}</div>
+                            </div>
+                        `;
+                    }).join('')}
+                </div>
+
+                <div class="insight-card">
+                    <div class="insight-title">Contradiction Hotspots</div>
+                    ${Object.values(contradictionEntities).slice(0, 10).map(entity => {
+                        const count = contradictions.filter(c => c.entity_id === entity.id).length;
+                        return `
+                            <div class="insight-item">
+                                <div class="insight-item-title">${escapeHtml(entity.name.substring(0, 40))}</div>
+                                <div class="insight-item-value">${count} contradictions</div>
+                            </div>
+                        `;
+                    }).join('')}
+                    ${Object.values(contradictionEntities).length === 0 ? '<div class="insight-item"><div class="insight-item-value">No contradictions found</div></div>' : ''}
+                </div>
+
+                <div class="insight-card">
+                    <div class="insight-title">Orphan Entities (No Relationships)</div>
+                    ${orphans.map(entity => `
+                        <div class="insight-item">
+                            <div class="insight-item-title">${escapeHtml(entity.name.substring(0, 40))}</div>
+                            <div class="insight-item-value">${entity.type}</div>
+                        </div>
+                    `).join('')}
+                    ${orphans.length === 0 ? '<div class="insight-item"><div class="insight-item-value">All entities have relationships</div></div>' : ''}
+                </div>
+
+                <div class="insight-card">
+                    <div class="insight-title">Belief Evolution</div>
+                    <div class="insight-item">
+                        <div class="insight-item-title">Total Beliefs</div>
+                        <div class="insight-item-value">${beliefs.length}</div>
+                    </div>
+                    <div class="insight-item">
+                        <div class="insight-item-title">Belief Transitions</div>
+                        <div class="insight-item-value">${beliefTransitions.length}</div>
+                    </div>
+                    <div class="insight-item">
+                        <div class="insight-item-title">Avg Transitions per Belief</div>
+                        <div class="insight-item-value">${(beliefTransitions.length / beliefs.length).toFixed(2)}</div>
+                    </div>
+                </div>
+
+                <div class="insight-card">
+                    <div class="insight-title">Relationship Statistics</div>
+                    <div class="insight-item">
+                        <div class="insight-item-title">Total Relationships</div>
+                        <div class="insight-item-value">${relationships.length}</div>
+                    </div>
+                    <div class="insight-item">
+                        <div class="insight-item-title">Avg per Entity</div>
+                        <div class="insight-item-value">${(relationships.length / entities.length).toFixed(2)}</div>
+                    </div>
+                </div>
+            `;
+        }
+
+        function formatJson(obj) {
+            const json = JSON.stringify(obj, null, 2);
+            return json
+                .replace(/&/g, '&amp;')
+                .replace(/</g, '&lt;')
+                .replace(/>/g, '&gt;')
+                .replace(/"([^"]+)":/g, '<span class="json-key">"$1"</span>:')
+                .replace(/: "([^"]*)"/g, ': <span class="json-string">"$1"</span>')
+                .replace(/: (\d+)/g, ': <span class="json-number">$1</span>')
+                .replace(/: (true|false)/g, ': <span class="json-null">$1</span>')
+                .replace(/: null/g, ': <span class="json-null">null</span>');
+        }
+
+        function escapeHtml(text) {
+            const div = document.createElement('div');
+            div.textContent = text;
+            return div.innerHTML;
+        }
+
+        function showError(message) {
+            const container = document.querySelector('.main-content');
+            container.innerHTML = `<div class="error-message">Error: ${escapeHtml(message)}</div>`;
+        }
+
+        // Start
+        init();
+    </script>
+</body>
+</html>
