+            organization: '#ce93d8',
+            belief: '#ef5350',
+            decision: '#ffd54f',
+            concept: '#90a4ae',
+            period: '#4db6ac',
+            event: '#7986cb'
+        };
+
+        const ENTITY_ICONS = {
+            person: '👤',
+            project: '📋',
+            tool: '🔧',
+            organization: '🏢',
+            belief: '💡',
+            decision: '⚖️',
+            concept: '🧠',
+            period: '📅',
+            event: '📍'
