+        }
+
+        function renderRelExpEntityList(search) {
+            const entities = Object.values(worldModel.entities)
+                .filter(e => !search || e.name.toLowerCase().includes(search))
+                .sort((a, b) => a.name.localeCompare(b.name));
+
+            const list = document.getElementById('relExpEntityList');
