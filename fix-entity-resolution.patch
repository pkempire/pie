+        }
+
+        function renderEntityDetail(entity) {
+            const panel = document.getElementById('detailPanel');
+            panel.classList.add('visible');
+
+            const transitionCounts = {};
+            Object.values(worldModel.transitions).forEach(t => {
+                transitionCounts[t.entity_id] = (transitionCounts[t.entity_id] || 0) + 1;
+            });
+
+            const transitions = Object.values(worldModel.transitions)
+                .filter(t => t.entity_id === entity.id)
+                .sort((a, b) => b.timestamp - a.timestamp);
+
+            const relationships = Object.values(worldModel.relationships)
+                .filter(r => r.source_id === entity.id || r.target_id === entity.id);
+
+            const firstSeen = new Date(entity.first_seen * 1000).toLocaleDateString();
+            const lastSeen = new Date(entity.last_seen * 1000).toLocaleDateString();
+
+            let stateHtml = '<div class="state-viewer">' + formatJson(entity.current_state) + '</div>';
+
+            let relationshipsHtml = '';
+            if (relationships.length > 0) {
+                relationships.forEach(rel => {
+                    const isSource = rel.source_id === entity.id;
+                    const otherId = isSource ? rel.target_id : rel.source_id;
+                    const otherEntity = worldModel.entities[otherId];
+                    const direction = isSource ? '→' : '←';
+                    relationshipsHtml += `
+                        <div class="relationship-item">
