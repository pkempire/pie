+
+        function renderTypeDistributionChart() {
+            const entities = Object.values(worldModel.entities);
+            const typeCounts = {};
+            entities.forEach(e => {
+                typeCounts[e.type] = (typeCounts[e.type] || 0) + 1;
+            });
+
+            const types = Object.keys(typeCounts);
+            const counts = Object.values(typeCounts);
+            const colors = types.map(t => ENTITY_COLORS[t] || '#90a4ae');
+
+            const canvas = document.getElementById('typeDistributionChart');
+            const ctx = canvas.getContext('2d');
+            canvas.width = canvas.offsetWidth;
+            canvas.height = canvas.offsetHeight;
+
+            const barWidth = canvas.width / (types.length + 1);
+            const maxCount = Math.max(...counts);
+            const padding = 40;
+
+            // Draw axes
+            ctx.strokeStyle = '#2a2a4e';
+            ctx.lineWidth = 1;
+            ctx.beginPath();
+            ctx.moveTo(padding, canvas.height - padding);
+            ctx.lineTo(canvas.width - padding, canvas.height - padding);
+            ctx.stroke();
+            ctx.beginPath();
+            ctx.moveTo(padding, padding);
+            ctx.lineTo(padding, canvas.height - padding);
+            ctx.stroke();
+
+            // Draw bars
+            types.forEach((type, i) => {
+                const x = padding + (i + 0.5) * barWidth;
+                const barHeight = (counts[i] / maxCount) * (canvas.height - 2 * padding);
+                const y = canvas.height - padding - barHeight;
+
+                ctx.fillStyle = colors[i];
+                ctx.fillRect(x - barWidth * 0.35, y, barWidth * 0.7, barHeight);
+
+                // Label
+                ctx.fillStyle = '#e0e0e0';
+                ctx.font = '12px sans-serif';
+                ctx.textAlign = 'center';
+                ctx.fillText(counts[i], x, y - 10);
+                ctx.fillText(type, x, canvas.height - 20);
+            });
+        }
+
+        function renderActivityTimelineChart() {
+            const transitions = Object.values(worldModel.transitions);
+            const dailyCounts = {};
+
+            transitions.forEach(t => {
+                const date = new Date(t.timestamp * 1000).toISOString().split('T')[0];
+                dailyCounts[date] = (dailyCounts[date] || 0) + 1;
+            });
+
+            const dates = Object.keys(dailyCounts).sort();
+            const counts = dates.map(d => dailyCounts[d]);
+
+            const canvas = document.getElementById('activityTimelineChart');
+            const ctx = canvas.getContext('2d');
+            canvas.width = canvas.offsetWidth;
+            canvas.height = canvas.offsetHeight;
+
+            const padding = 40;
+            const maxCount = Math.max(...counts);
+            const spacing = (canvas.width - 2 * padding) / (dates.length - 1 || 1);
+
+            // Draw axes
+            ctx.strokeStyle = '#2a2a4e';
+            ctx.lineWidth = 1;
+            ctx.beginPath();
+            ctx.moveTo(padding, canvas.height - padding);
+            ctx.lineTo(canvas.width - padding, canvas.height - padding);
+            ctx.stroke();
+            ctx.beginPath();
+            ctx.moveTo(padding, padding);
+            ctx.lineTo(padding, canvas.height - padding);
+            ctx.stroke();
+
+            // Draw line
+            ctx.strokeStyle = '#4fc3f7';
+            ctx.lineWidth = 2;
+            ctx.beginPath();
+            counts.forEach((count, i) => {
+                const x = padding + i * spacing;
+                const y = canvas.height - padding - (count / maxCount) * (canvas.height - 2 * padding);
+                if (i === 0) ctx.moveTo(x, y);
+                else ctx.lineTo(x, y);
+            });
+            ctx.stroke();
+
+            // Draw points
+            ctx.fillStyle = '#4fc3f7';
+            counts.forEach((count, i) => {
+                const x = padding + i * spacing;
+                const y = canvas.height - padding - (count / maxCount) * (canvas.height - 2 * padding);
+                ctx.beginPath();
+                ctx.arc(x, y, 3, 0, Math.PI * 2);
+                ctx.fill();
+            });
+
+            // Labels
+            ctx.fillStyle = '#90a4ae';
+            ctx.font = '10px sans-serif';
+            ctx.textAlign = 'center';
+            [0, Math.floor(dates.length / 2), dates.length - 1].forEach(i => {
+                if (i < dates.length) {
+                    ctx.fillText(dates[i], padding + i * spacing, canvas.height - 10);
+                }
+            });
+        }
+
+        function renderEntityList() {
+            let entities = Object.values(worldModel.entities);
+
+            // Filter
+            if (currentPage.filters.search) {
+                const search = currentPage.filters.search;
+                entities = entities.filter(e =>
+                    e.name.toLowerCase().includes(search) ||
+                    e.aliases.some(a => a.toLowerCase().includes(search))
+                );
+            }
+
+            if (currentPage.filters.type) {
+                entities = entities.filter(e => e.type === currentPage.filters.type);
+            }
+
+            // Sort
+            const transitionCounts = {};
+            Object.values(worldModel.transitions).forEach(t => {
+                transitionCounts[t.entity_id] = (transitionCounts[t.entity_id] || 0) + 1;
+            });
+
+            entities.sort((a, b) => {
+                switch (currentPage.filters.sortBy) {
+                    case 'name':
+                        return a.name.localeCompare(b.name);
+                    case 'type':
+                        return a.type.localeCompare(b.type);
+                    case 'transitions':
+                        return (transitionCounts[b.id] || 0) - (transitionCounts[a.id] || 0);
+                    case 'first_seen':
+                        return (b.first_seen || 0) - (a.first_seen || 0);
+                    case 'last_seen':
+                        return (b.last_seen || 0) - (a.last_seen || 0);
+                    default:
+                        return 0;
+                }
+            });
+
+            currentPage.entities = entities;
+
+            const list = document.getElementById('entityList');
