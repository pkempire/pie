+            "cooccurrences": briefing_cooccurrences(report),
+            "predictions": report.predicted_next_transitions[:10],
+            "people": briefing_people(wm),
+        }
+        print(json.dumps(output, indent=2, default=str))
+    else:
+        print_briefing(wm, report)
+
